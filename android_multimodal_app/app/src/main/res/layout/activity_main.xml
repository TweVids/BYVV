<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:weightSum="10">

    <!-- PART 1: TOP (BIGGEST ~50-55%): Camera Viewfinder & Settings Button -->
    <FrameLayout
        android:id="@+id/cameraContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5.2"
        android:background="#000000">

        <androidx.camera.view.PreviewView
            android:id="@+id/viewFinder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Camera viewfinder displaying surroundings" />

        <!-- Status banner over camera -->
        <TextView
            android:id="@+id/cameraStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="#B3000000"
            android:padding="10dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:text="Camera Hoạt Động - Giữ nút để nói" />

        <!-- Settings Gear Button on top-right -->
        <Button
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:text="⚙ CÀI ĐẶT"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="#444444"
            android:textColor="#FFFFFF"
            android:contentDescription="Mở cài đặt API key và mô hình" />
    </FrameLayout>

    <!-- PART 2: MIDDLE (~33%): Simplified Conversation Boxes (User Turn & AI Turn) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3.3"
        android:orientation="vertical"
        android:padding="10dp"
        android:weightSum="2">

        <!-- USER TURN BOX -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="10dp"
            android:layout_marginBottom="6dp"
            android:contentDescription="Hộp văn bản của người dùng">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BẠN (USER):"
                android:textColor="#4CAF50"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="2dp">
                <TextView
                    android:id="@+id/userTurnText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:text="Giữ nút 'NÓI VỚI AI' bên dưới để đặt câu hỏi..." />
            </ScrollView>
        </LinearLayout>

        <!-- AI TURN BOX -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="10dp"
            android:contentDescription="Hộp phản hồi của trợ lý AI">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRỢ LÝ AI (RESPONSE):"
                android:textColor="#2196F3"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="2dp">
                <TextView
                    android:id="@+id/aiTurnText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFF55"
                    android:textSize="18sp"
                    android:text="Chờ bạn nói hoặc chụp hình..." />
            </ScrollView>
        </LinearLayout>

    </LinearLayout>

    <!-- PART 3: BOTTOM (~15%): Big High-Contrast Hold-to-Speak Button -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5"
        android:padding="10dp">

        <Button
            android:id="@+id/holdToSpeakBtn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:backgroundTint="#FFD600"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold"
            android:text="🎤 GIỮ ĐỂ NÓI (HOLD TO SPEAK)"
            android:contentDescription="Nút lớn giữ để nói và chụp ảnh xung quanh cho trợ lý AI" />
    </FrameLayout>

</LinearLayout>
